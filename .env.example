# Example environment configuration for go-sample-metric
# Copy this file to .env and adjust values as needed.
# These are safe demo defaults. Durations follow Go's time.ParseDuration format.

SERVICE_NAME=sample-metric-service
SERVICE_ENV=development
SERVICE_APP=demo
SERVICE_VERSION=0.1.0

# HTTP server port
PORT=8090

# Metrics export configuration
METRIC_EXPORT_INTERVAL=5s
METRIC_EXPORT_TIMEOUT=10s

# Simulated work latency range (milliseconds)
WORK_MIN_LATENCY_MS=50
WORK_MAX_LATENCY_MS=300

# Simulated error rate percentage (0-100)
ERROR_RATE_PERCENT=10

# Graceful shutdown timeout
SHUTDOWN_TIMEOUT=5s

# ==========================================
# EXPORTER CONFIGURATION
# ==========================================

# Exporter type: http, grpc
EXPORTER_TYPE=http

# ==========================================
# DATADOG DIRECT EXPORT
# ==========================================

# Set DD_ENABLED=true to send metrics directly to Datadog
DD_ENABLED=false

# Your Datadog API key (required when DD_ENABLED=true)
DD_API_KEY=your_datadog_api_key_here

# Datadog site (datadoghq.com, datadoghq.eu, us3.datadoghq.com, etc.)
DD_SITE=datadoghq.com

# ==========================================
# CUSTOM OTLP ENDPOINT
# ==========================================

# Custom OTLP endpoint (used when DD_ENABLED=false)
# For local testing with otel-collector:
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9529/v1/write/metric

# For sending to other OTLP-compatible endpoints:
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
