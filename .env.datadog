# Datadog Direct Export Configuration
# Copy this file to .env when you want to send metrics directly to Datadog

SERVICE_NAME=sample-metric-service
SERVICE_ENV=production
SERVICE_APP=demo
SERVICE_VERSION=1.0.0
PORT=8090

# Metrics export configuration
METRIC_EXPORT_INTERVAL=10s
METRIC_EXPORT_TIMEOUT=30s

# Work simulation configuration
WORK_MIN_LATENCY_MS=50
WORK_MAX_LATENCY_MS=300
ERROR_RATE_PERCENT=5

# Shutdown configuration
SHUTDOWN_TIMEOUT=5s

# ==========================================
# DATADOG CONFIGURATION
# ==========================================

# Enable Datadog direct export
DD_ENABLED=true

# Your Datadog API key (get this from Datadog -> Organization Settings -> API Keys)
DD_API_KEY=your_actual_datadog_api_key_here

# Datadog site - choose based on your Datadog account region:
# - datadoghq.com (US1)
# - datadoghq.eu (EU)
# - us3.datadoghq.com (US3)
# - us5.datadoghq.com (US5)
# - ap1.datadoghq.com (AP1)
DD_SITE=datadoghq.com

# Exporter type: http (recommended) or grpc
EXPORTER_TYPE=http

# Note: OTEL_EXPORTER_OTLP_METRICS_ENDPOINT will be automatically set
# based on DD_SITE and EXPORTER_TYPE when DD_ENABLED=true